[Unit]
Description=India Post AI Shipment Assistant Service Orchestrator
After=network.target

[Service]
Type=simple
User=indiapost
Group=indiapost
WorkingDirectory=/opt/IndiaPost_AI_Assistant
EnvironmentFile=/opt/IndiaPost_AI_Assistant/.env
ExecStart=/opt/IndiaPost_AI_Assistant/venv/bin/python orchestrator.py --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=15s

# Security Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
